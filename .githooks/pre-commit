#!/usr/bin/env bash
# Rejects a commit whose staged .nix files are not alejandra-formatted. Enable with: git config core.hooksPath .githooks
set -euo pipefail

if ! command -v alejandra > /dev/null; then
  echo "pre-commit: alejandra not on PATH, skipping the formatting check" >&2
  exit 0
fi

# Check the staged blob rather than the working tree file, so what the commit records is what gets checked.
# read -d works in macOS's Bash 3.2 and preserves spaces and newlines in paths.
failed=0
while IFS= read -r -d '' file; do
  if ! git show ":$file" | alejandra --check --quiet - > /dev/null; then
    printf 'pre-commit: not alejandra-formatted as staged: %s\n' "$file" >&2
    failed=1
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.nix')

if [ "$failed" -ne 0 ]; then
  echo "pre-commit: run 'alejandra .' and stage the result" >&2
  exit 1
fi
